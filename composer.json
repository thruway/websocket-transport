{
    "name": "thruway/websocket-transport",
    "type": "library",
    "description": "WebSocket Transport for Thruway",
    "keywords": [
        "WebSockets",
        "Server",
        "Client",
        "WAMP",
        "WAMP2",
        "Autobahn",
        "Sockets"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Matt Bonneau", "email": "matt@bonneau.net", "role": "Developer"
        },

        {
            "name": "David Dan", "email": "davidwdan@gmail.com", "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Thruway\\Transport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thruway\\Test\\": "test/"
        }
    },
    "require": {
        "voryx/thruway": "^0.5",
        "react/socket": "^1.0 || ^0.8.3",
        "ratchet/rfc6455": "^0.3.1",
        "guzzlehttp/psr7": "^1.9"
    },
    "require-dev": {
        "ratchet/pawl": "^0.3.1",
        "thruway/pawl-transport": "^0.5.0",
        "thruway/client": "^0.5.2",
        "phpunit/phpunit": "^12.5",
        "psr/http-message": "^1.1"
    }
}
